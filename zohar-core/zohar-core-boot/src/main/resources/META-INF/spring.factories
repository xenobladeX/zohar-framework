org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
  org.zohar.framework.core.boot.config.ZoharAutoConfiguration,\
  org.zohar.framework.core.boot.config.JacksonConfiguration,\
  org.zohar.framework.core.boot.config.ValidationAutoConfiguration

org.springframework.boot.SpringApplicationRunListener=\
 org.zohar.framework.core.boot.ExtensionApplicationRunListener